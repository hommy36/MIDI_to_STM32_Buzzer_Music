{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "midi-buzzer-studio",
  "version": "0.1.0",
  "identifier": "com.midibuzzer.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MIDI Buzzer Studio",
        "width": 1120,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "windowEffects": {
          "effects": ["acrylic"],
          "state": "active",
          "radius": 12
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
